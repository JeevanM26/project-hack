# ==============================================================================
# J.A.R.V.I.S. Mark LXXXV Environment Configuration
# HP HyperX (Intel i7 14th Gen, NVIDIA RTX 5060, 24 GB RAM)
# ==============================================================================

# Google AI Studio API Key (Optional Turbo Cloud Fallback for Gemma 4 26B-A4B-it / 31B-it)
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# Sarvam AI API Subscription Key (Saaras v4 STT + Bulbul v4 Flash TTS 24kHz)
SARVAM_API_KEY="your_sarvam_api_key_here"

# Single Gemma 4 Model Selector (Unified Vision + Text + UI Pointing)
# Local: gemma4:12b or gemma4:e4b | API: gemma-4-12b-it or gemma-4-26b-a4b-it
JARVIS_GEMMA_MODEL="gemma-4-12b-it"

# Local Ollama Inference Base URL (Accelerated on RTX 5060 8GB VRAM)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Target Repository Directory for AST Grounding
JARVIS_REPO_DIR="sample_repo"

# Desktop Display Mode (0 = Visible Mouse on Screen, 1 = Headless)
JARVIS_HEADLESS="0"
