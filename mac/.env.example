# Hugging Face API key / token to access google/gemma-4-instruct via huggingface_hub
GEMMA_API_KEY=hf_your_huggingface_token_here

# Alternatively HF_TOKEN is also supported:
# HF_TOKEN=hf_your_huggingface_token_here

# Note: If no API key is provided, the application automatically runs using the
# built-in offline PM fallback engine so all task board actions continue working seamlessly.
